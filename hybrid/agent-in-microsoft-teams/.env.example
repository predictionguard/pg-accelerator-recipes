# Copy to .env and fill in. One .env per agent you expose to Teams.
#
# Syntax: KEY=value, one per line, no `export`. Quotes are stripped rather
# than respected, so APP_NAME="my app" still yields the invalid `my app` —
# they hide a bad value rather than legalising it. A trailing `# comment` is
# ignored. A variable already set in your shell wins over this file.
# ---------------------------------------------------------------------------

# === REQUIRED: your Agent Forge agent ======================================

# A scoped Agent Studio key (sk-agentstudio-...) bound to the agent below.
AGENT_API_KEY=

# The agent's id — the value sent as "model" to /v1/chat/completions.
# Copy it from the agent's API tab in Agent Studio.
AGENT_ID=

# Your Agent Forge deployment's host, without a version segment — the code
# appends /v1 itself. Agent Forge is deployed per customer, so check the base
# URL shown in Agent Studio and change this to match.
#   public      https://forge-api.predictionguard.com
#   dedicated   https://agents.your-org.com
#   self-hosted https://forge.internal.your-org.com
AGENT_FORGE_BASE_URL=https://forge-api.predictionguard.com

# Give up on a slow agent after this many seconds.
AGENT_FORGE_TIMEOUT=120


# === Azure deployment ======================================================
# Used by scripts/deploy_azure.sh.

# Names EVERY Azure resource this deploys: <APP_NAME>-rg, <APP_NAME>-func,
# <APP_NAME>-bot, and the storage account. Must be globally unique. Lowercase
# letters, digits and hyphens — no spaces. If you want a name with spaces for
# what colleagues see in Teams, that is TEAMS_APP_NAME further down; this one
# becomes a public hostname.
#
# Set it HERE rather than exporting it in your shell. The deploy script only
# updates resources whose names match, and a shell export is gone the moment you
# close the terminal — so the next run silently falls back to the built-in
# default and provisions a second, separate deployment instead of updating
# yours. Nothing errors when that happens, which is what makes it worth the
# warning.
APP_NAME=

# Azure region for every resource above.
LOCATION=eastus

# Optional: by default the resource group is <APP_NAME>-rg. Set this to put
# several agents' resources in one group.
# RESOURCE_GROUP=


# === REQUIRED for Teams: the Azure Bot identity ============================
# Written for you by scripts/deploy_azure.sh. Leave blank to run locally
# against scripts/local_teams_sim.py, which needs no bot registration.
#
# SingleTenant because Azure no longer accepts multi-tenant bot creation. The
# bot then only serves Teams users in its own tenant for anything needing user
# consent; plain message exchange still works from other tenants.

MicrosoftAppType=SingleTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=


# === How the bot behaves ===================================================

# Prepended to every request. Use it to shape tone or add Teams-specific
# framing; the agent's own instructions in Agent Studio still apply.
SYSTEM_PROMPT=

# Sent when someone installs or adds the bot.
WELCOME_MESSAGE=

# How many previous user+assistant pairs to replay, so the agent can follow
# up. Higher = better memory, more tokens per turn.
HISTORY_TURNS=8

# Forget a conversation after this long idle.
HISTORY_TTL_SECONDS=3600


# === How the app appears in Teams ==========================================
# Used by scripts/build_teams_package.py when building the upload zip.

# Shown in the Teams app list and as the bot's name. Max 30 characters.
TEAMS_APP_NAME=Agent Forge

# The Teams app identity. MUST be a unique GUID per agent, and MUST stay the
# same across rebuilds of the same agent or Teams treats your next upload as
# a different app. Leave blank on first build and the script generates one
# and prints it for you to paste back here.
TEAMS_APP_ID=

# Optional overrides; sensible defaults are derived from TEAMS_APP_NAME.
TEAMS_APP_DESCRIPTION=
DEVELOPER_NAME=
DEVELOPER_URL=
